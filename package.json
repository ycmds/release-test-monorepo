{
  "name": "@macrobe/root",
  "version": "1.1.0",
  "type": "module",
  "description": "Functional utility library for modern TypeScript, ESM, ES6+!",
  "author": "Igor Suvorov <hi@isuvorov.com> (https://github.com/isuvorov)",
  "private": true,
  "scripts": {
    "dev": "                 pnpm -r dev",
    "build": "               pnpm -r build",
    "test": "                pnpm -r test",
    "fix": "                 pnpm -r fix",
    "release": "             multi-semantic-release",
    "release:old": "         pnpm -r exec -- npx --no-install semantic-release -e semantic-release-monorepo",
    "release:dry": "         pnpm -r exec -- npx --no-install semantic-release -e semantic-release-monorepo --dry-run"
  },
  "devDependencies": {
    "@anolilab/multi-semantic-release": "^3.2.2",
    "@biomejs/biome": "^2.3.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/node": "^24.9.1",
    "semantic-release": "^25.0.2",
    "size-limit": "^11.2.0",
    "tsdown": "^0.15.11",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "//": "///////////========================/////////========================/////////========================/////////",
  "///": "//////////========================/////////========================/////////========================/////////",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycmds/release-test-monorepo.git"
  },
  "homepage": "https://github.com/ycmds/release-test-monorepo",
  "bugs": "https://github.com/ycmds/release-test-monorepo/issues",
  "license": "MIT",
  "keywords": [
    "utility",
    "library",
    "typescript",
    "esm",
    "es6",
    "functional",
    "programming",
    "utils",
    "helpers"
  ],
  "////": "/////////========================/////////========================/////////========================/////////"
}
